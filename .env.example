# backbone-rest — Environment Variables
# Copy this file to .env at the project root and fill in the real values.
# DO NOT commit a .env file with real secrets to version control.
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  PROTECTED FILES — NO AGENT MAY MODIFY THESE FILES UNDER ANY CIRCUMSTANCE
# ─────────────────────────────────────────────────────────────────────────────
# The following files are governance / configuration artifacts and are
# READ-ONLY for ALL agents (Developer, QA, DevOps, Orchestrator, etc.):
#
#   • .env  (and .env.example)
#   • .github/copilot-instructions.md
#   • Every file inside the .github/ directory:
#       .github/agents/
#       .github/hooks/
#       .github/prompts/
#       .github/skills/
#       .github/tools/
#       .github/workflows/
#       .github/copilot-agents.md
#
# Only a human operator with explicit project-owner approval may edit them.
# Agents that need a rule change must open a proposal (PR / issue) instead.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_PORT=8443
APP_TOKEN_SECRET=change-me-use-a-strong-random-secret
APP_TOKEN_EXPIRATION=3600000

# ─────────────────────────────────────────────
# Spring Boot Profile
# ─────────────────────────────────────────────
SPRING_BOOT_PROFILE_ACTIVE=local
SPRING_BOOT_CLOUD_BOOTSTRAP_ENABLED=false

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOGGING_TRACE_ENABLED=false

# ─────────────────────────────────────────────
# SSL / TLS (JKS bundle: backbone-rest-security)
# ─────────────────────────────────────────────
SSL_KEYSTORE_LOCATION=keystore/backbone-rest.p12
SSL_KEYSTORE_PASSWORD=change-me
SSL_KEYSTORE_TYPE=PKCS12
SSL_TRUSTSTORE_LOCATION=keystore/backbone-rest-trust.p12
SSL_TRUSTSTORE_PASSWORD=change-me
SSL_TRUSTSTORE_TYPE=PKCS12

# ─────────────────────────────────────────────
# OAuth2 / Keycloak (resource-server + client)
# ─────────────────────────────────────────────
AUTH_SERVER_URI=https://keycloak.example.com/realms/prx
AUTH_CERT_URI=/protocol/openid-connect/certs
AUTH_CLIENT_ID=backbone-rest-client
AUTH_CLIENT_SECRET=change-me

# ─────────────────────────────────────────────
# Spring Cloud Config Server
# ─────────────────────────────────────────────
CNFS_URI=https://config-server.example.com
CNFS_PORT=443
SPRING_CLOUD_CONFIG_LABEL=main

# ─────────────────────────────────────────────
# HashiCorp Vault
# ─────────────────────────────────────────────
VAULT_ENABLED=false
VAULT_SERVER_URI=http://vault.example.com:8200
VAULT_SERVER_URL=vault.example.com:8200
VAULT_TOKEN=change-me

# ─────────────────────────────────────────────
# Repsy — private Maven registry
# Required to resolve com.prx:* dependencies
# ─────────────────────────────────────────────
REPSY_ACCOUNT_USER=change-me
REPSY_ACCOUNT_PASSWORD=change-me

