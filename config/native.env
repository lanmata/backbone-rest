# Build/smoke-test only config for the "native" Spring profile (GraalVM Native Image).
# Versioned on purpose — every value below is a harmless placeholder, never a credential,
# and none of it points at real infrastructure.
#
# Why this file exists: `spring-boot:process-aot` and the resulting native binary both require
# a full ApplicationContext refresh to succeed — unlike a plain `mvn test` run, there is no way
# to mock your way around it. application.yml's undefaulted ${VAR} placeholders are normally
# filled in by Vault/Config Server at runtime, which requires live QA infrastructure this build
# does not have access to and should not depend on. This file supplies safe, syntactically-valid
# dummy values for all of them instead, so the app can boot far enough for AOT processing /
# native-image compilation / a local smoke test without touching Vault, Config Server, or a real
# Postgres instance. It is not a deployment configuration. Pattern copied from mercury's own
# config/native.env (MER-5) — see that repo's docs/architecture/graalvm-native-image.md.
#
# Usage: set -a; source config/native.env; set +a; mvn -Pnative clean package -DskipTests

SPRING_BOOT_PROFILE_ACTIVE=native
VAULT_ENABLED=false
SPRING_CLOUD_CONFIG_LABEL=native
CNFS_URI=http://localhost:9999
CNFS_PORT=9999
VAULT_TOKEN=dummy
LOGGING_TRACE_ENABLED=false
APP_PORT=8084
APP_TOKEN_SECRET=dummy
APP_TOKEN_EXPIRATION=3600000

# Real dev keystore/truststore files already on the classpath (src/main/resources/*.jks) —
# not dummy values, these are needed for Tomcat's HTTPS listener to actually start.
SSL_KEYSTORE_LOCATION=backbone.jks
SSL_KEYSTORE_PASSWORD=changeit
SSL_KEYSTORE_TYPE=JKS
SSL_TRUSTSTORE_LOCATION=umdc-truststore.jks
SSL_TRUSTSTORE_PASSWORD=changeit
SSL_TRUSTSTORE_TYPE=JKS

# Postgres — HikariCP must not block context refresh on an unreachable DB. DataSourceSslConfig
# defaults spring.datasource.hikari.initialization-fail-timeout to 1ms (fail-fast); overridden to
# -1 here per that class's own documented escape hatch ("useful for tests where the DB may be
# intentionally unreachable during startup"). URL/user/password just need to be syntactically
# valid for the driver, never actually connected to.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/backbone
SPRING_DATASOURCE_USERNAME=backbone
SPRING_DATASOURCE_PASSWORD=dummy
SPRING_DATASOURCE_HIKARI_INITIALIZATION_FAIL_TIMEOUT=-1
# application.yml sets hibernate.boot.allow_jdbc_metadata_access=true, which makes Hibernate try
# a real JDBC connection during EntityManagerFactory bootstrap to auto-detect the dialect — that
# WOULD block (or fail) context refresh against an unreachable localhost:5432, unlike Hikari's own
# lazy pool init above. Disabled for this build-time-only profile; real deployments still get true.
SPRING_JPA_PROPERTIES_HIBERNATE_BOOT_ALLOW_JDBC_METADATA_ACCESS=false
# Explicit dialect so Hibernate doesn't need metadata access to pick one either.
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Supabase Storage / auth — dummy, unused when nothing calls out to Supabase during boot.
AUTH_SERVER_URI=http://localhost:9999

# spring-cloud-starter-netflix-eureka-client's @RefreshScope "eurekaClient" bean definition
# can't be AOT-code-generated (Spring's ValueCodeGenerator has no support for RefreshScope
# values — a known Spring Cloud + AOT/native-image incompatibility, not backbone-specific;
# mercury's own config/native.env disables it the same way).
EUREKA_CLIENT_ENABLED=false

# Confirmed upstream regression (spring-projects/spring-data-commons#3499, Spring Data
# 4.0.6+): process-aot's own generated repository sources fail to compile with
# "jakarta.validation.Constraint is not a repeatable annotation interface" for every JPA
# repository method with a Bean Validation annotation on a parameter. Spring Data's own
# documented escape hatch — falls back to normal runtime repository proxies (still fully
# native-image compatible, just without that one AOT optimization). Same workaround
# mercury's config/native.env uses.
SPRING_AOT_REPOSITORIES_ENABLED=false

UMDC_CORS_ALLOWED_ORIGINS=http://localhost:3000
MCAM_KEY_ALIAS=backbone-rest
MCAM_TOKEN_TTL_SECONDS=3600
MCAM_ROTATION_GRACE_SECONDS=300
MCAM_RATE_LIMIT_RPM=60

# app.environments.contact.limit / messages.user.* have no default anywhere in this repo's own
# resources today (normally Vault/Config-Server-supplied) — dummy values here just so context
# refresh doesn't fail on an unresolved placeholder.
APP_ENVIRONMENTS_CONTACT_LIMIT=5
MESSAGES_USER_CLAVE_NO_PERMITIDA=dummy
MESSAGES_USER_CLAVE_VACIA_NULA=dummy
MESSAGES_USER_CORREO_EXISTE=dummy
MESSAGES_USER_CORREO_NO_VALIDO=dummy
MESSAGES_USER_CORREO_VACIO=dummy
MESSAGES_USER_LOGIN_VACIO_NULO=dummy
MESSAGES_USER_SIN_DATOS=dummy
MESSAGES_USER_SOLICITUD_EXITOSA=dummy
MESSAGES_USER_SOLICITUD_NULA_VACIA=dummy
MESSAGES_USER_USUARIO_CREADO=dummy
MESSAGES_USER_USUARIO_EXISTE=dummy
MESSAGES_USER_USUARIO_INVALIDO=dummy
