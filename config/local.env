# Non-secret, per-environment bootstrap config for docker-compose. Versioned on purpose
# (see the .gitignore exception for config/*.env) — nothing in this file is a credential.
# It only tells backbone-rest which environment it's running against and how to reach the
# Vault/Config Server that then supplies everything else (DB, mail, OAuth, etc. all come
# from Vault's KV store at runtime, keyed per environment — they never belong in this file
# or in a Helm values file). Same split mercury uses: config/local.env (this file, versioned)
# + secrets/local.env (gitignored, the one bootstrap secret Vault can't hand us: VAULT_TOKEN).

APP_PORT=8084

SPRING_BOOT_PROFILE_ACTIVE=remote-supabase
SPRING_CLOUD_CONFIG_LABEL=Develop

VAULT_ENABLED=true
VAULT_URI=https://vault.umdc-qa.tst
VAULT_KV_BACKEND=dev

CNFS_PORT=443
CNFS_URI=https://config-server.umdc-qa.tst

# TLS identity for Tomcat's HTTPS listener / outbound *.tst calls. Not secrets — "changeit"
# is the shared placeholder password baked into every dev keystore in certs/backbone/, and
# the location/type values just name which files on the classpath to load (see pom.xml's
# <resources> entry for certs/backbone).
SSL_KEYSTORE_LOCATION=backbone.jks
SSL_KEYSTORE_PASSWORD=changeit
SSL_KEYSTORE_TYPE=JKS
SSL_TRUSTSTORE_LOCATION=umdc-truststore.jks
SSL_TRUSTSTORE_PASSWORD=changeit
SSL_TRUSTSTORE_TYPE=JKS
