{
  "permissions": {
    "allow": [
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_status",
      "mcp__codegraph__codegraph_files",
      "Bash(mvn *)",
      "Bash(mvn -DskipTests compile)",
      "Bash(mvn -DskipTests compile -q)",
      "Bash(mvn test)",
      "Bash(mvn pmd:check)",
      "Bash(mvn pmd:check pmd:cpd-check)",
      "Bash(mvn -DskipTests package)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(find . *)",
      "Bash(find src *)",
      "Bash(grep -r *)",
      "Bash(grep -l *)",
      "Bash(grep -n *)",
      "Bash(docker build *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker compose *)",
      "Bash(java -version)",
      "Bash(mvn --version)",
      "Bash(cat pom.xml)",
      "Bash(cat src/main/resources/bootstrap.yml)",
      "Bash(ls src/main/java/com/umdc/backoffice/v1/*)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(mvn deploy *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); file=$(echo \"$input\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))\" 2>/dev/null); if [[ \"$file\" == *.java ]]; then cd /Users/lmata/projects/GitHub/backbone-rest && echo '--- compile check ---' && mvn -DskipTests compile -q 2>&1 | tail -15; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n[backbone-rest] Reminder: run `mvn test` to validate PMD + JaCoCo before opening a PR.'"
          }
        ]
      }
    ]
  },
  "env": {
    "REPSY_ACCOUNT_USER": "",
    "REPSY_ACCOUNT_PASSWORD": ""
  }
}
